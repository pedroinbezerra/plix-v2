# ==========================================
# PLIX - CONFIGURAÇÃO DE AMBIENTE (HOMELAB)
# ==========================================

# Banco PostgreSQL externo
# Informe o host, usuário, senha e banco fornecidos pelo seu provedor.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public"

# The Movie Database (TMDB) API Read Access Token (Bearer)
# Obtenha em: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=""
TMDB_LANGUAGE="pt-BR"
TMDB_REGION="BR"

# Provedores de Catálogo e Reprodução (Isole integrações externas)
CATALOG_PROVIDER_BASE_URL="https://warezcdn.sbs"
PLAYBACK_PROVIDER_BASE_URL="https://warezcdn.sbs"
POMFY_PLAYBACK_BASE_URL="https://api.pomfy.stream"
POMFY_CATALOG_BASE_URL="https://api.pomfy.stream"
STREAMBETTER_PLAYBACK_BASE_URL="https://streambetter.shop"
DEFAULT_PLAYBACK_PROVIDER="warez"

# Autenticação e Sessões (Gere uma chave aleatória segura, ex: openssl rand -hex 32)
AUTH_SECRET="plix_super_secret_auth_key_replace_in_production_32chars"

# Usuário Administrador Inicial (Criado automaticamente pelo seed)
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="password123"

# Servidor e Rede Local
PORT=3000
HOST="0.0.0.0"
